Index: synce-core-0.17/scripts/synce-udev-serial.in
===================================================================
--- synce-core-0.17.orig/scripts/synce-udev-serial.in
+++ synce-core-0.17/scripts/synce-udev-serial.in
@@ -2,6 +2,18 @@

 logger -p daemon.info -t synce-udev-serial "INFO : serial event, ACTION = $ACTION, INTERFACE = $INTERFACE, DEVPATH = $DEVPATH, SUBSYSTEM = $SUBSYSTEM, DEVNAME = $DEVNAME"

-@SYNCEDATADIR@/udev-synce-serial &
+# Since systemd (Debian 8+ / Ubuntu 16+) all processes spawned by a udev
+# rule share the udev worker cgroup and are killed when the worker becomes
+# idle ("Cleanup idle workers").  Using systemd-run places the handler in a
+# new transient service unit with its own cgroup, which survives the udev
+# worker lifetime.
+/bin/systemd-run --no-block \
+    --description="SynCE serial device event handler ($ACTION $DEVNAME)" \
+    --setenv=ACTION="$ACTION" \
+    --setenv=DEVPATH="$DEVPATH" \
+    --setenv=SUBSYSTEM="$SUBSYSTEM" \
+    --setenv=DEVNAME="$DEVNAME" \
+    --setenv=INTERFACE="${INTERFACE:-}" \
+    @SYNCEDATADIR@/udev-synce-serial

 exit 0
