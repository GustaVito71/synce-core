#!/usr/bin/make -f

%:
	dh $@ --with python3

override_dh_makeshlibs:
	dh_makeshlibs -V 'libsynce0 (>= 0.17-0~bookworm1)'

override_dh_auto_configure:
	dh_auto_configure -- \
		--disable-rpath \
		--libexecdir=/usr/lib/synce-core \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--enable-python-bindings

override_dh_install:
	dh_install
	for file in $$(ls debian/synce-tools/usr/bin/p* 2>/dev/null); do \
		mv $$file debian/synce-tools/usr/bin/synce-$$(basename $$file); \
	done

override_dh_installman:
	dh_installman
	for file in $$(ls debian/synce-tools/usr/share/man/man1/p* 2>/dev/null); do \
		mv $$file debian/synce-tools/usr/share/man/man1/synce-$$(basename $$file); \
	done
